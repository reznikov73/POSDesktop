{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:dev",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "posdesktop"],
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "build:release",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release", "-p", "posdesktop"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--workspace", "--all-targets", "--", "-D", "warnings"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "d0:spike",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "-p", "posdesktop-d0-spike"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "installer",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/installer.ps1"],
      "problemMatcher": []
    },
    {
      "label": "publish",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/release.ps1"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
