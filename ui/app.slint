export struct AppItem {
    name: string,
}

export struct AppGroup {
    title: string,
    apps: [AppItem],
}

export struct Tile {
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
}

export component WorkspaceWindow inherits Window {
    title: "POS Desktop — рабочая область";
    no-frame: true;
    width: ws-width;
    height: ws-height;
    background: transparent;
    default-font-family: "Segoe UI";

    in property <length> ws-width: 1920px;
    in property <length> ws-height: 1080px;
    in property <[Tile]> tiles: [];

    for tile in tiles : Rectangle {
        x: tile.x;
        y: tile.y;
        width: tile.w;
        height: tile.h;
        border-radius: 12px;
        background: #fbfcfc;
        border-width: 1px;
        border-color: #dfe3e5;

        Text {
            text: tile.label;
            color: #17181a;
            font-size: 13px;
            x: 12px;
            y: 12px;
        }
    }
}

export component AppWindow inherits Window {
    title: "POS Desktop";
    no-frame: true;
    width: 380px;
    height: win-height;
    background: #fbfcfc;
    default-font-family: "Segoe UI";

    in property <length> win-height: 720px;

    in property <[AppGroup]> groups: [
        {
            title: "Офис",
            apps: [
                { name: "1С:Предприятие" },
                { name: "Word" },
                { name: "Excel" },
                { name: "PowerPoint" },
                { name: "Outlook" },
            ],
        },
        {
            title: "Разработка",
            apps: [
                { name: "VS Code" },
                { name: "Терминал" },
                { name: "Git Bash" },
            ],
        },
        {
            title: "Интернет",
            apps: [
                { name: "Telegram" },
                { name: "WhatsApp" },
                { name: "Zoom" },
            ],
        },
    ];

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "ПРИЛОЖЕНИЯ";
                color: #6d6f73;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: "11";
                color: #6d6f73;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 36px;
            border-radius: 8px;
            background: #f1f4f5;
            border-width: 1px;
            border-color: #dfe3e5;

            Text {
                text: "Найти приложение…";
                color: #8a8c8f;
                font-size: 13px;
                x: 12px;
                height: 100%;
                vertical-alignment: center;
            }
        }

        for group in groups : VerticalLayout {
            spacing: 2px;

            Text {
                text: group.title;
                color: #8a8c8f;
                font-size: 10px;
                height: 24px;
                vertical-alignment: bottom;
            }

            for app in group.apps : Rectangle {
                height: 38px;
                border-radius: 8px;
                background: touch.has-hover ? #eef1f2 : transparent;

                touch := TouchArea {
                    width: 100%;
                    height: 100%;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: app.name;
                        color: #17181a;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component StatusBar inherits Window {
    title: "POS Desktop — статус";
    no-frame: true;
    width: bar-width;
    height: 44px;
    background: #fbfcfc;
    default-font-family: "Segoe UI";

    in property <length> bar-width: 1280px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #e6eaea;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 18px;

        VerticalLayout {
            alignment: center;
            Text {
                text: "ИЗБРАННОЕ";
                color: #8a8c8f;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: "Почта 12";
                color: #17181a;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: "POSvpn — защищено";
                color: #0c7f68;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: "Бэкап — вчера";
                color: #565862;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: "CI — упал";
                color: #b3261e;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

export component ServicesBar inherits Window {
    title: "POS Desktop — сервисы";
    no-frame: true;
    width: bar-width;
    height: 48px;
    background: #fbfcfc;
    default-font-family: "Segoe UI";

    in property <length> bar-width: 1280px;

    Rectangle {
        y: 0;
        height: 1px;
        background: #e6eaea;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 18px;
        alignment: center;

        Text {
            text: "СЕРВИСЫ";
            color: #8a8c8f;
            font-size: 10px;
            vertical-alignment: center;
        }

        Text {
            text: "POSCloud — работает";
            color: #17181a;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: "POSvpn — защищено";
            color: #17181a;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: "grm-autobackup — работает";
            color: #17181a;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}
