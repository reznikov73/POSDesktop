    Rectangle {
        background: #fbfcfc;

        Rectangle {
            y: 0;
            height: 1px;
            background: #e6eaea;
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 18px;
            alignment: center;

            Text {
                text: "СЕРВИСЫ";
                color: #8a8c8f;
                font-size: 10px;
                vertical-alignment: center;
            }

            Text {
                text: "POSCloud — работает";
                color: #17181a;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: "POSvpn — защищено";
