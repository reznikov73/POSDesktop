export struct AppItem {
    name: string,
}

export struct AppGroup {
    title: string,
    apps: [AppItem],
}

// data-transfer в Slint непрозрачен: пути читает Rust.
export global DropApi {
    pure callback files(data-transfer) -> [string];
}

export struct Tile {
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
    // Монограмма плитки — запасной вариант, если иконка не нашлась.
    badge: string,
    icon: image,
    has-icon: bool,
    // Иконки плитки-папки: до четырёх, как в сетке Android.
    icons: [image],
}

export component WorkspaceWindow inherits Window {
    title: "POS Desktop — рабочая область";
    no-frame: true;
    width: ws-width;
    height: ws-height;
    background: transparent;
    default-font-family: "Segoe UI";

    in property <length> ws-width: 1920px;
    in property <length> ws-height: 1080px;
    in-out property <[Tile]> tiles: [];
    // Индекс перетаскиваемой плитки, -1 — перетаскивания нет.
    in property <int> drag-index: -1;
    // Призрак: место, куда плитка встанет после привязки к сетке.
    in property <bool> ghost-visible: false;
    in property <length> ghost-x: 0px;
    in property <length> ghost-y: 0px;
    in property <length> ghost-w: 0px;
    in property <length> ghost-h: 0px;

    callback tile-pressed(int);
    callback tile-clicked(int);
    // Файлы, брошенные из Проводника: пути и точка в координатах окна.
    callback files-dropped([string], length, length);

    // Slint принимает броски сам (winit держит OLE drop-target),
    // поэтому файлы ловим элементом DropArea, а не WM_DROPFILES.
    DropArea {
        can-drop(event) => {
            return event.proposed-action;
        }
        dropped(event) => {
            root.files-dropped(DropApi.files(event.data), event.position.x, event.position.y);
            return event.proposed-action;
        }
    }

    // Призрак рисуется под плитками и показывает привязанную позицию.
    Rectangle {
        visible: root.ghost-visible;
        x: root.ghost-x;
        y: root.ghost-y;
        width: root.ghost-w;
        height: root.ghost-h;
        border-radius: 12px;
        background: #0c7f6830;
        border-width: 2px;
        border-color: #0c7f68;
        opacity: 0.6;
    }

    for tile[idx] in root.tiles : Rectangle {
        x: tile.x;
        y: tile.y;
        width: tile.w;
        height: tile.h;
        border-radius: 12px;
        background: root.drag-index == idx ? #ffffff : #fbfcfc;
        border-width: root.drag-index == idx ? 2px : 1px;
        border-color: root.drag-index == idx ? #0c7f68 : #dfe3e5;

        // Папка: сетка 2×2 из иконок вложенных приложений.
        if (tile.icons.length > 1) : Rectangle {
            for icon[i] in tile.icons : Image {
                source: icon;
                x: (parent.width - 67px) / 2 + Math.mod(i, 2) * 37px;
                y: (parent.height - 67px) / 2 + Math.floor(i / 2) * 37px;
                width: 30px;
                height: 30px;
                image-fit: contain;
            }
        }

        // Абсолютная раскладка: плитка не должна зависеть от растяжения layout.
        Image {
            visible: tile.has-icon && tile.icons.length <= 1;
            source: tile.icon;
            x: (parent.width - 34px) / 2;
            y: 12px;
            width: 34px;
            height: 34px;
            image-fit: contain;
        }

        Rectangle {
            visible: !tile.has-icon;
            x: (parent.width - 34px) / 2;
            y: 12px;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: root.drag-index == idx ? #d9efe8 : #eef1f2;

            Text {
                text: tile.badge;
                width: 100%;
                height: 100%;
                color: #0c7f68;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            visible: tile.icons.length <= 1;
            text: tile.label;
            x: 6px;
            y: 52px;
            width: parent.width - 12px;
            height: 28px;
            color: #17181a;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }

        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.tile-pressed(idx);
                }
            }
            clicked => {
                root.tile-clicked(idx);
            }
        }
    }
}

export struct FolderItem {
    label: string,
    icon: image,
    has-icon: bool,
    badge: string,
}

export component FolderWindow inherits Window {
    title: "POS Desktop — папка";
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";
    width: 348px;
    height: content-height;

    in property <length> content-height: 260px;
    in property <string> folder-title: "Папка";
    in property <[FolderItem]> items: [];

    callback item-clicked(int);
    callback close-requested();

    Rectangle {
        background: #fbfcfc;
        border-radius: 14px;
        border-width: 1px;
        border-color: #dfe3e5;

        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            alignment: start;

            HorizontalLayout {
                height: 22px;

                Text {
                    text: folder-title;
                    color: #17181a;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: close-touch.has-hover ? #eef1f2 : transparent;

                    close-touch := TouchArea {
                        clicked => {
                            root.close-requested();
                        }
                    }

                    Text {
                        text: "×";
                        width: 100%;
                        height: 100%;
                        color: #565862;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            GridLayout {
                spacing: 10px;

                for item[idx] in items : VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 12px;
                        background: #f1f4f5;

                        Image {
                            visible: item.has-icon;
                            source: item.icon;
                            x: 6px;
                            y: 6px;
                            width: 32px;
                            height: 32px;
                            image-fit: contain;
                        }

                        Text {
                            visible: !item.has-icon;
                            text: item.badge;
                            width: 100%;
                            height: 100%;
                            color: #0c7f68;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: item.label;
                        width: 64px;
                        height: 28px;
                        color: #17181a;
                        font-size: 11px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "POS Desktop";
    no-frame: true;
    width: 380px;
    height: win-height;
    background: #fbfcfc;
    default-font-family: "Segoe UI";

    in property <length> win-height: 720px;

    in property <[AppGroup]> groups: [
        {
            title: "Офис",
            apps: [
                { name: "1С:Предприятие" },
                { name: "Word" },
                { name: "Excel" },
                { name: "PowerPoint" },
                { name: "Outlook" },
            ],
        },
        {
            title: "Разработка",
            apps: [
                { name: "VS Code" },
                { name: "Терминал" },
                { name: "Git Bash" },
            ],
        },
        {
            title: "Интернет",
            apps: [
                { name: "Telegram" },
                { name: "WhatsApp" },
                { name: "Zoom" },
            ],
        },
    ];

    // Фон панели рисуем явным прямоугольником: окно не должно просвечивать.
    Rectangle {
        background: #fbfcfc;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            height: 100%;
            background: #dfe3e5;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            // Без alignment шапка растягивалась и отрывала поиск от списка.
            alignment: start;

            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Text {
                    text: "ПРИЛОЖЕНИЯ";
                    color: #6d6f73;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: "11";
                    color: #6d6f73;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: #f1f4f5;
                border-width: 1px;
                border-color: #dfe3e5;

                Text {
                    text: "Найти приложение…";
                    color: #8a8c8f;
                    font-size: 13px;
                    x: 12px;
                    height: 100%;
                    vertical-alignment: center;
                }
            }

            for group in groups : VerticalLayout {
                spacing: 2px;

                Text {
                    text: group.title;
                    color: #8a8c8f;
                    font-size: 10px;
                    height: 24px;
                    vertical-alignment: bottom;
                }

                for app in group.apps : Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: touch.has-hover ? #eef1f2 : transparent;

                    touch := TouchArea {
                        width: 100%;
                        height: 100%;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            text: app.name;
                            color: #17181a;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component StatusBar inherits Window {
    title: "POS Desktop — статус";
    no-frame: true;
    width: bar-width;
    height: 44px;
    background: #fbfcfc;
    default-font-family: "Segoe UI";

    in property <length> bar-width: 1280px;
    // Счётчик почты: «Почта 12», «Почта 0» или «Почта —», если Soroka недоступна.
    in property <string> mail-text: "Почта —";

    Rectangle {
        background: #fbfcfc;

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: #e6eaea;
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 18px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "ИЗБРАННОЕ";
                    color: #8a8c8f;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: mail-text;
                    color: #17181a;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "POSvpn — защищено";
                    color: #0c7f68;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Бэкап — вчера";
                    color: #565862;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "CI — упал";
                    color: #b3261e;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

