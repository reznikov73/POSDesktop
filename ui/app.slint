export struct AppItem {
    name: string,
}

export struct AppGroup {
    title: string,
    apps: [AppItem],
}

export component AppWindow inherits Window {
    title: "POS Desktop";
    width: 380px;
    height: 720px;
    background: #fbfcfc;
    default-font-family: "Segoe UI";

    in property <[AppGroup]> groups: [
        {
            title: "Офис",
            apps: [
                { name: "1С:Предприятие" },
                { name: "Word" },
                { name: "Excel" },
                { name: "PowerPoint" },
                { name: "Outlook" },
            ],
        },
        {
            title: "Разработка",
            apps: [
                { name: "VS Code" },
                { name: "Терминал" },
                { name: "Git Bash" },
            ],
        },
        {
            title: "Интернет",
            apps: [
                { name: "Telegram" },
                { name: "WhatsApp" },
                { name: "Zoom" },
            ],
        },
    ];

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "ПРИЛОЖЕНИЯ";
                color: #6d6f73;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: "11";
                color: #6d6f73;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 36px;
            border-radius: 8px;
            background: #f1f4f5;
            border-width: 1px;
            border-color: #dfe3e5;

            Text {
                text: "Найти приложение…";
                color: #8a8c8f;
                font-size: 13px;
                x: 12px;
                height: 100%;
                vertical-alignment: center;
            }
        }

        for group in groups : VerticalLayout {
            spacing: 2px;

            Text {
                text: group.title;
                color: #8a8c8f;
                font-size: 10px;
                height: 24px;
                vertical-alignment: bottom;
            }

            for app in group.apps : Rectangle {
                height: 38px;
                border-radius: 8px;
                background: touch.has-hover ? #eef1f2 : transparent;

                touch := TouchArea {
                    width: 100%;
                    height: 100%;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: app.name;
                        color: #17181a;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
